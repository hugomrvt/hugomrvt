{
  "$description": "HUGO.CLI colours, dark theme. Values read from the TUI view of hugo.mourlev.at.",
  "color": {
    "$type": "color",
    "canvas": {
      "$description": "Card background. Same value as the GitHub page behind it, so only the frame draws the window.",
      "$value": { "colorSpace": "srgb", "components": [0.051, 0.0667, 0.0902], "hex": "#0d1117" }
    },
    "line": {
      "frame": {
        "$description": "Outline of the card.",
        "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.1, "hex": "#ffffff" }
      },
      "chip": {
        "$description": "Outline of the version and site chips.",
        "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.08, "hex": "#ffffff" }
      },
      "hairline": {
        "$description": "Rules under the top bar and above the prompt.",
        "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.06, "hex": "#ffffff" }
      },
      "edge": {
        "$description": "Left edge of a user message.",
        "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.12, "hex": "#ffffff" }
      }
    },
    "text": {
      "strong": {
        "$value": { "colorSpace": "srgb", "components": [0.9412, 0.9647, 0.9882], "hex": "#f0f6fc" }
      },
      "default": {
        "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.75, "hex": "#ffffff" }
      },
      "dim": {
        "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.3, "hex": "#ffffff" }
      },
      "faint": {
        "$description": "Small uppercase labels.",
        "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.25, "hex": "#ffffff" }
      },
      "placeholder": {
        "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.12, "hex": "#ffffff" }
      }
    },
    "accent": {
      "default": {
        "$value": { "colorSpace": "srgb", "components": [0.8549, 0.4667, 0.3373], "hex": "#da7756" }
      },
      "subtle": {
        "$description": "Fill of the model badge.",
        "$value": { "colorSpace": "srgb", "components": [0.8549, 0.4667, 0.3373], "alpha": 0.06, "hex": "#da7756" }
      },
      "border": {
        "$description": "Outline of the model badge.",
        "$value": { "colorSpace": "srgb", "components": [0.8549, 0.4667, 0.3373], "alpha": 0.2, "hex": "#da7756" }
      }
    },
    "success": {
      "$value": { "colorSpace": "srgb", "components": [0.2471, 0.7255, 0.3137], "hex": "#3fb950" }
    },
    "surface": {
      "raised": {
        "$description": "Fill of a user message and of the site chip.",
        "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.03, "hex": "#ffffff" }
      }
    }
  }
}
